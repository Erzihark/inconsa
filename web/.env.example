# Copy to web/.env for local dev, and set the same vars in Vercel (Project → Settings
# → Environment Variables) for Production + Preview. All must be present at BUILD time.

# --- Public site URL (production domain) ---
# Drives canonical URLs, hreflang, sitemap and OG tags. No trailing slash.
NUXT_PUBLIC_SITE_URL=https://www.inconsa.mx

# --- Sanity (public dataset, read-only) ---
NUXT_PUBLIC_SANITY_PROJECT_ID=4sxos8s4
NUXT_PUBLIC_SANITY_DATASET=production

# --- Contact form (server-only) ---
# Without a key the form still works but only logs the message server-side.
# Get a key at https://resend.com and verify the sending domain.
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO_EMAIL=contacto@inconsa.mx
