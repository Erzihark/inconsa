{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "inconsa-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "web",
      "port": 3000
    },
    {
      "name": "inconsa-web-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [".output/server/index.mjs"],
      "cwd": "web",
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "inconsa-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "studio",
      "port": 3333
    }
  ]
}
